{
  "compilerOptions": {
    "allowJs": false,
    "target": "ES2020",
    "module": "commonjs",
    "strict": false,
    "importHelpers": true,
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "noImplicitAny": false,
    "experimentalDecorators": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "outDir": "lib",
    "types": [
      "jest",
      "node"
    ],
    "lib": [
      "ES2019",
      "DOM",
      "DOM.Iterable"
    ],
    "typeRoots": [
      "./typings",
      "node_modules/@types"
    ]
  },
  "include": [
    "src/*.ts",
    "src/**/*.node.ts"
  ],
  "exclude": [
    "lib",
    "coverage",
    "node_modules",
    "**/__mocks__"
  ]
}

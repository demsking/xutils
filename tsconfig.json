{
  "compilerOptions": {
    "allowJs": true,
    "target": "es6",
    "module": "commonjs",
    "strict": true,
    "importHelpers": true,
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "experimentalDecorators": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "outDir": "dist",
    "types": [
      "node",
      "jest"
    ],
    "paths": {},
    "lib": [
      "ES2019",
      "DOM"
    ],
    "typeRoots": [
      "."
    ]
  },
  "include": [
    "**/*.ts"
  ],
  "exclude": [
    "dist",
    "coverage",
    "node_modules",
    "**/__mocks__"
  ]
}

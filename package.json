  "scripts": {
    "lint": "eslint .",
    "test": "jest --detectOpenHandles --coverage",
    "watch": "jest --detectOpenHandles --no-coverage --watchAll",
    "build": "rm -rf lib* && tsc && tsc -p tsconfig.browser.json && cp src/*.d.ts lib/ && mkdir -p libtmp && cp --parents src/*/package.json libtmp/ && cp -r libtmp/src/* lib/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.com/demsking/xutils.git"
  },
  "bugs": {
    "url": "https://gitlab.com/demsking/xutils/issues"
  },
  "homepage": "https://gitlab.com/demsking/xutils",
  "keywords": [
    "image",
    "promise",
    "array",
    "client",
    "number",
    "string",
    "regex",
    "schema",
    "server",
    "circular list",
    "utils"
  ],
  "author": "Sébastien Demanou",
  "types": "typings.d.ts",
  "dependencies": {
    "axios": "0.27.2",
    "axios-cache-adapter": "^2.7.3",
    "body-parser": "^1.19.2",
    "cli-color": "^2.0.0",
    "express": "^4.18.1",
    "image-downloader": "^4.2.0",
    "jimp": "^0.16.1",
    "morgan": "^1.10.0",
    "tslib": "^2.4.0"
  },
  "devDependencies": {
    "@types/cli-color": "^2.0.1",
    "@types/express": "^4.17.13",
    "@types/jest": "^27.4.0",
    "@types/morgan": "^1.9.3",
    "@types/node": "^17.0.30",
    "@typescript-eslint/eslint-plugin": "^5.21.0",
    "@typescript-eslint/parser": "^5.21.0",
    "eslint": "^8.14.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-plugin-import": "^2.25.4",
    "eslint-plugin-jest": "^26.1.5",
    "eslint-plugin-radar": "^0.2.1",
    "jest": "28.0.3",
    "nock": "^13.2.4",
    "ts-jest": "28.0.1",
    "typescript": "^4.6.4"
  }
